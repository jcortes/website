---
import "../styles/global.css";
import { localizedPath, ogImagePath } from "../i18n/paths";
import {
  defaultLocale,
  locales,
  useTranslations,
  type Locale,
} from "../i18n/ui";
import SiteHeader from "../components/SiteHeader.astro";
import ThemeScript from "../components/ThemeScript.astro";
import CircuitBackground from "../components/CircuitBackground.astro";

interface Props {
  locale: Locale;
  /** Page title; the site title is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Set by the home page only (see SiteHeader). */
  home?: boolean;
}

const { locale, title, description, home = false } = Astro.props;
const t = useTranslations(locale);
const fullTitle = title ? `${title} · ${t("site.title")}` : t("site.title");
const pageDescription = description ?? t("site.description");

// Absolute URLs on the production origin (`site` in astro.config.mjs).
const absolute = (path: string) => new URL(path, Astro.site).href;
const canonical = absolute(Astro.url.pathname);
const alternates = [
  ...locales.map((other) => ({
    hreflang: other,
    href: absolute(localizedPath(Astro.url.pathname, other)),
  })),
  {
    hreflang: "x-default",
    href: absolute(localizedPath(Astro.url.pathname, defaultLocale)),
  },
];
const ogLocales: Record<Locale, string> = { es: "es_CO", en: "en_US" };
// Cookie-free page views (Cloudflare Web Analytics); production builds only.
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <ThemeScript />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {alternates.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jorge Cortes" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {locales
      .filter((other) => other !== locale)
      .map((other) => (
        <meta property="og:locale:alternate" content={ogLocales[other]} />
      ))}
    <meta property="og:image" content={absolute(ogImagePath(locale))} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t("site.title")} />
    <meta name="twitter:card" content="summary_large_image" />
    {analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      />
    )}
  </head>
  <body class="relative isolate min-h-dvh">
    <CircuitBackground />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:rounded focus:bg-surface-raised focus:px-3 focus:py-2"
    >
      {t("nav.skipToContent")}
    </a>
    <SiteHeader locale={locale} home={home} />
    <main id="main">
      <slot />
    </main>
    <script>
      import { trackMarkedClicks } from "../analytics/track";

      trackMarkedClicks(document);
    </script>
  </body>
</html>
