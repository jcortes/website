---
import "../styles/global.css";
import { useTranslations, type Locale } from "../i18n/ui";
import SiteHeader from "../components/SiteHeader.astro";
import ThemeScript from "../components/ThemeScript.astro";
import CircuitBackground from "../components/CircuitBackground.astro";

interface Props {
  locale: Locale;
  /** Page title; the site title is appended. Omit on the home page. */
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const t = useTranslations(locale);
const fullTitle = title ? `${title} · ${t("site.title")}` : t("site.title");
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <ThemeScript />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description ?? t("site.description")} />
  </head>
  <body class="relative isolate min-h-dvh">
    <CircuitBackground />
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:rounded focus:bg-surface-raised focus:px-3 focus:py-2"
    >
      {t("nav.skipToContent")}
    </a>
    <SiteHeader locale={locale} />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
