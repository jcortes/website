---
import { localizedPath, sectionPath } from "../i18n/paths";
import { useTranslations, type Locale } from "../i18n/ui";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
// Chosen variant; alternatives live alongside it in src/assets/brand/.
import Logo from "../assets/brand/logo-c-solid.svg";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<header class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-5">
  <a
    href={localizedPath("/", locale)}
    class="flex items-center gap-3 font-mono text-sm font-semibold tracking-wide"
  >
    <Logo class="size-9" />
    <span>Jorge Cortés</span>
    <span class="sr-only">· {t("nav.home")}</span>
  </a>
  <div class="flex items-center gap-3">
    <nav aria-label={t("nav.main")}>
      <ul class="flex items-center gap-1">
        {(
          [
            ["services", "nav.services"],
            ["about", "nav.about"],
          ] as const
        ).map(([section, label]) => (
          <li>
            <a
              href={sectionPath(locale, section)}
              class="rounded-md px-2.5 py-1.5 text-sm text-ink-muted transition-colors hover:text-accent"
            >
              {t(label)}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <LanguageSwitcher locale={locale} />
    <ThemeToggle locale={locale} />
  </div>
</header>
